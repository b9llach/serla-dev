{
  "name": "serla-js",
  "version": "0.3.1",
  "description": "Official JavaScript SDK for Serla analytics",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "tsup"
  },
  "keywords": [
    "analytics",
    "events",
    "tracking",
    "serla",
    "metrics"
  ],
  "peerDependencies": {
    "rrweb": "^2.0.0-alpha.4"
  },
  "peerDependenciesMeta": {
    "rrweb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.0",
    "jsdom": "^25.0.0",
    "rrweb": "^2.0.0-alpha.4",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
