{
  "name": "serla-js-react",
  "version": "0.1.1",
  "description": "Official React bindings for the Serla analytics JS SDK",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup"
  },
  "keywords": [
    "analytics",
    "events",
    "tracking",
    "serla",
    "metrics",
    "react",
    "hooks"
  ],
  "peerDependencies": {
    "react": ">=18",
    "serla-js": ">=0.3.0 <1.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "serla-js": "file:../serla-js",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
